# Settings template for Technically Social.
# Copy this file, rename the copy to ".env", and fill in your real values.
# NEVER upload the real .env to GitHub. The secret key can read and change everything.

# From Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=paste-your-secret-key-here

# Where the pages should find the backend server.
# On your own computer this stays as-is.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Password for the organizer page at /admin. Pick something long that's hard to guess.
# If this is left blank, the organizer page stays locked for everyone.
ADMIN_PASSWORD=

# The event's time zone, so "today" means today in New York (not London time).
EVENT_TIMEZONE=America/New_York

# Optional: change the server's port or which website is allowed to talk to it.
# API_PORT=4000
# API_CORS_ORIGIN=http://localhost:3000
